rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: Block all read/write at the root
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() { 
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'admin'; 
    }

    function isStaff() { 
      let data = getUserData();
      return isSignedIn() && data != null && (data.role == 'staff' || data.role == 'admin'); 
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // User profiles
    match /users/{userId} {
      // Allow user to read their own profile, and staff/admins to read any profile
      allow read: if isOwner(userId) || isStaff();
      
      // Allow registration: user can create their own profile as 'student'
      allow create: if isOwner(userId) 
        && incoming().role == 'student'
        && incoming().uid == userId
        && incoming().keys().hasAll(['uid', 'email', 'role'])
        && incoming().keys().size() >= 3;
        
      // Allow updates to own profile, but NOT to role (only staff/admins can change roles)
      allow update: if isOwner(userId) 
        && incoming().role == existing().role
        && incoming().uid == existing().uid;
        
      // Admins can update anything
      allow update: if isAdmin();
      
      allow delete: if isAdmin();
    }

    // Faculty (Public read)
    match /faculty/{facultyId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Courses (Public read)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Research (Public read)
    match /research/{paperId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Announcements
    match /announcements/{annId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Chats
    match /chats/{roomId} {
      allow read: if isSignedIn();
      
      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() 
          && incoming().senderId == request.auth.uid
          && incoming().text is string 
          && incoming().text.size() <= 1000;
        allow delete: if isAdmin() || (existing().senderId == request.auth.uid);
      }
    }
  }
}
