rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: Block all read/write at the root
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.email == 'mk.rabbani.cse@gmail.com');
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }

    function isAdmin() { 
      return isSuperAdmin();
    }

    function isStaff() { 
      return isSuperAdmin();
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      
      allow create: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Faculty (Public read)
    match /faculty/{facultyId} {
      allow read: if true;
      allow write: if isStaff() && isValidId(facultyId);
    }

    // Courses (Public read)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isStaff() && isValidId(courseId);
    }

    // Research (Public read)
    match /research/{paperId} {
      allow read: if true;
      allow write: if isStaff() && isValidId(paperId);
    }

    // Announcements
    match /announcements/{annId} {
      allow read: if true;
      allow write: if isStaff() && isValidId(annId);
    }

    // Chats
    match /chats/{roomId} {
      allow read: if isSignedIn() && isValidId(roomId);
      
      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() 
          && isValidId(msgId)
          && incoming().senderId == request.auth.uid
          && incoming().text is string 
          && incoming().text.size() <= 1000;
        allow delete: if isAdmin() || (existing().senderId == request.auth.uid);
      }
    }
  }
}
